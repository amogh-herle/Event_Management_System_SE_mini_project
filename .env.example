DATABASE_URL="postgresql://user:password@localhost:5432/event_management_system"

# Gmail SMTP for verification/reset/notification emails.
# Generate an App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification enabled first). Leave unset in dev and the
# mailer falls back to a disposable Ethereal test inbox automatically.
EMAIL_USER=""
EMAIL_PASS=""

# Secret used to sign session cookies (FR-002a login). Any long random
# string — e.g. `openssl rand -hex 32`. Changing it invalidates all
# existing sessions.
SESSION_SECRET=""

# Base URL embedded in outbound emails (verification, password reset
# links). Set this explicitly in production (e.g. "https://events.example.edu").
# Leave unset in local dev: links built from a localhost request
# automatically swap in the host machine's own LAN IP instead, so a link
# emailed during testing still works when opened from another device.
PUBLIC_APP_ORIGIN=""
